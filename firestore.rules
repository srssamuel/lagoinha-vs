rules_version = '2';

// Regras do banco online (docs/architecture/spec-banco-online.md, secoes 3 e 4).
// O papel mora em churches/{churchId}/members/{uid}, nunca em users/{uid}.
// Invariantes cobertas pela suite tests/rules (npm run test:rules):
//   I1 ninguem altera o proprio papel/status nem entra como ativo sozinho
//   I2 igreja A nunca le nada de churches/B/**
//   I3 convite: +1 por uso, so valido, nao revogado e dentro do prazo, e gera membro pendente
//   I4 catalog/** so por curador, e so material proprio ou licenciado com documento
// Tudo que nao esta listado aqui e negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(churchId, uid) {
      return /databases/$(database)/documents/churches/$(churchId)/members/$(uid);
    }

    function invitePath(churchId, inviteId) {
      return /databases/$(database)/documents/churches/$(churchId)/invites/$(inviteId);
    }

    // Membro ativo da igreja com papel de pelo menos `minRank` (musico 0, tecnico 1, lider 2, admin 3)
    function hasRank(churchId, minRank) {
      return signedIn()
        && exists(memberPath(churchId, request.auth.uid))
        && get(memberPath(churchId, request.auth.uid)).data.status == 'active'
        && rankOf(get(memberPath(churchId, request.auth.uid)).data.role) >= minRank;
    }

    function rankOf(role) {
      return {'musician': 0, 'sound_tech': 1, 'leader': 2, 'admin': 3}.get(role, -1);
    }

    function isActiveMember(churchId) {
      return hasRank(churchId, 0);
    }

    function isCurator() {
      return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // Catalogo global: membro ativo de alguma igreja. O usuario aponta a igreja em users/{uid}.primaryChurchId
    // e a regra confere o membro ativo la; apontar uma igreja onde nao e membro nao libera nada.
    function isActiveSomewhere() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isActiveMember(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('primaryChurchId', '_'));
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function catalogEligible(data) {
      return data.rightsClass in ['own', 'licensed_redistributable']
        && data.licenseRef is map
        && nonEmptyString(data.licenseRef.get('holder', ''))
        && nonEmptyString(data.licenseRef.get('documentId', ''));
    }

    function validRole(role) {
      return role in ['admin', 'leader', 'sound_tech', 'musician'];
    }

    // Ate onde cada papel convida: admin ate lider, lider ate tecnico de som
    function canInviteRole(churchId, targetRole) {
      return validRole(targetRole)
        && hasRank(churchId, 2)
        && rankOf(targetRole) <= {'admin': 2, 'leader': 1}.get(get(memberPath(churchId, request.auth.uid)).data.role, -1);
    }

    // ---------- Curadores do catalogo global: cadastrados so pelo console (Admin SDK) ----------
    match /platformAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------- Perfil: sem papel e sem igreja com poder; so a propria pessoa le ----------
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'primaryChurchId', 'createdAt'])
        && (!('displayName' in request.resource.data) || nonEmptyString(request.resource.data.displayName));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Catalogo global (I4) ----------
    match /catalog/{songId} {
      allow read: if isActiveSomewhere() || isCurator();
      allow create, update: if isCurator() && catalogEligible(request.resource.data);
      allow delete: if isCurator();

      // Versao so nasce sob musica que ja passou pela I4
      match /versions/{versionId} {
        allow read: if isActiveSomewhere() || isCurator();
        allow create: if isCurator()
          && exists(/databases/$(database)/documents/catalog/$(songId))
          && catalogEligible(get(/databases/$(database)/documents/catalog/$(songId)).data)
          && validVersion(request.resource.data);
        allow update, delete: if false; // versao e imutavel
      }
    }

    // ---------- Igreja ----------
    match /churches/{churchId} {
      // Igreja nasce pelo console no bootstrap (F2); admin so edita nome e cidade
      allow read: if isActiveMember(churchId);
      allow update: if hasRank(churchId, 3)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'city'])
        && optString(request.resource.data, 'name', 100)
        && optString(request.resource.data, 'city', 100);
      allow create, delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || hasRank(churchId, 2));
        allow list: if hasRank(churchId, 2);

        // Entrada pelo convite (I1, I3): a propria pessoa, pendente, com o papel do convite,
        // no mesmo lote que consome o convite. Admin tambem cadastra direto (admin novo so por admin).
        allow create: if (
            signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['role', 'status', 'inviteId', 'displayName', 'instrument', 'createdAt'])
            && request.resource.data.status == 'pending'
            && profileFieldsValid(request.resource.data)
            && inviteConsumedBy(churchId, request.resource.data.inviteId, request.resource.data.role)
          ) || (
            hasRank(churchId, 3) && request.auth.uid != uid
            && request.resource.data.keys().hasOnly(['role', 'status', 'displayName', 'instrument', 'createdAt', 'approvedBy', 'approvedAt'])
            && validRole(request.resource.data.role)
            && request.resource.data.status in ['pending', 'active']
            && profileFieldsValid(request.resource.data)
            && request.resource.data.get('approvedBy', request.auth.uid) == request.auth.uid
          );

        // So admin aprova, troca papel ou suspende, e nunca a si mesmo (I1).
        // Rebaixar, suspender ou remover um admin e so pelo console: a igreja nunca fica sem admin pelo app.
        // A propria pessoa so mexe no nome e no instrumento.
        allow update: if (
            hasRank(churchId, 3) && request.auth.uid != uid
            && resource.data.role != 'admin'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['role', 'status', 'approvedBy', 'approvedAt', 'instrument'])
            && validRole(request.resource.data.role)
            && request.resource.data.status in ['pending', 'active', 'suspended']
            && profileFieldsValid(request.resource.data)
            && (!('approvedBy' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.approvedBy == request.auth.uid)
          ) || (
            signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'instrument'])
            && profileFieldsValid(request.resource.data)
          );

        // Sair da igreja: a propria pessoa, menos admin (console) e suspenso (sair apagaria a suspensao).
        // Admin remove os outros, menos outro admin.
        allow delete: if signedIn() && resource.data.role != 'admin' && (
            (request.auth.uid == uid && resource.data.status != 'suspended')
            || hasRank(churchId, 3)
          );
      }

      // inviteId = sha256 (hex) do token do link: so quem tem o link sabe o id (get), so a lideranca lista.
      match /invites/{inviteId} {
        allow get: if signedIn();
        allow list: if hasRank(churchId, 2);

        allow create: if canInviteRole(churchId, request.resource.data.targetRole)
          && inviteId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['targetRole', 'expiresAt', 'maxUses', 'usedCount', 'createdBy', 'revoked', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.usedCount == 0
          && request.resource.data.revoked == false
          && request.resource.data.maxUses is int
          && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 100
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(30, 'd');

        // Consumo: +1, so quem entra como membro pendente neste mesmo lote (I3)
        allow update: if (
            signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
            && request.resource.data.usedCount == resource.data.usedCount + 1
            && inviteUsable(churchId, resource.data)
            && !exists(memberPath(churchId, request.auth.uid))
            && existsAfter(memberPath(churchId, request.auth.uid))
            && getAfter(memberPath(churchId, request.auth.uid)).data.inviteId == inviteId
          ) || (
            // Revogar: quem criou (ainda lideranca) ou admin; so o campo revoked, so para true
            (hasRank(churchId, 3) || (hasRank(churchId, 2) && resource.data.createdBy == request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
            && request.resource.data.revoked == true
          );

        allow delete: if hasRank(churchId, 3);
      }

      // Biblioteca privada da igreja: qualquer rightsClass; nunca vira catalogo por aqui
      match /library/{songId} {
        allow read: if isActiveMember(churchId);
        allow create, update: if hasRank(churchId, 1)
          && request.resource.data.rightsClass in ['own', 'licensed_redistributable', 'church_purchased', 'unknown']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200;
        allow delete: if hasRank(churchId, 2);

        // Versao so nasce sob musica existente da propria igreja. Que os sha256 listados sejam
        // arquivos desta igreja quem garante e o Worker (spec, I5): a regra nao percorre listas.
        match /versions/{versionId} {
          allow read: if isActiveMember(churchId);
          allow create: if hasRank(churchId, 1)
            && exists(/databases/$(database)/documents/churches/$(churchId)/library/$(songId))
            && validVersion(request.resource.data);
          allow update, delete: if false; // versao e imutavel
        }
      }

      // Setlist do culto: revisao sobe exatamente 1 a cada escrita (o cliente grava em transacao)
      match /setlists/{setlistId} {
        allow read: if isActiveMember(churchId);
        allow create: if hasRank(churchId, 2)
          && request.resource.data.revision == 1
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100;
        allow update: if hasRank(churchId, 2)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100;
        allow delete: if hasRank(churchId, 2);
      }
    }

    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    function profileFieldsValid(data) {
      return optString(data, 'displayName', 100) && optString(data, 'instrument', 100);
    }

    function validVersion(data) {
      return data.keys().hasOnly(['createdAt', 'createdBy', 'changelog', 'sections', 'stems'])
        && data.createdBy == request.auth.uid
        && data.stems is list && data.stems.size() <= 64
        && optString(data, 'changelog', 500);
    }

    // Valido, nao revogado, no prazo, e quem convidou ainda e lideranca ativa da igreja
    function inviteUsable(churchId, invite) {
      return invite.revoked == false
        && invite.usedCount < invite.maxUses
        && request.time < invite.expiresAt
        && exists(memberPath(churchId, invite.createdBy))
        && get(memberPath(churchId, invite.createdBy)).data.status == 'active'
        && rankOf(get(memberPath(churchId, invite.createdBy)).data.role) >= 2;
    }
    // O convite existia valido antes do lote, sobe 1 no lote e o papel pedido e o do convite
    function inviteConsumedBy(churchId, inviteId, role) {
      return inviteId is string
        && exists(invitePath(churchId, inviteId))
        && inviteUsable(churchId, get(invitePath(churchId, inviteId)).data)
        && getAfter(invitePath(churchId, inviteId)).data.usedCount == get(invitePath(churchId, inviteId)).data.usedCount + 1
        && role == get(invitePath(churchId, inviteId)).data.targetRole;
    }
  }
}
