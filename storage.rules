rules_version = '2';

// Stems moram no Cloudflare R2 atras do Worker (ADR-001), nao no Firebase Storage.
// Aqui ficam so as capas, com o papel lido de churches/{churchId}/members/{uid}.
// Qualquer outro caminho (inclusive o antigo churches/{id}/stems/**) e negado.
service firebase.storage {
  match /b/{bucket}/o {

    function member(churchId) {
      return firestore.get(/databases/(default)/documents/churches/$(churchId)/members/$(request.auth.uid));
    }

    function isActiveMember(churchId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/churches/$(churchId)/members/$(request.auth.uid))
        && member(churchId).data.status == 'active';
    }

    function canUpload(churchId) {
      return isActiveMember(churchId) && member(churchId).data.role in ['admin', 'leader', 'sound_tech'];
    }

    match /churches/{churchId}/covers/{imageFile} {
      allow read: if isActiveMember(churchId);
      allow create, update: if canUpload(churchId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // No delete nao ha request.resource
      allow delete: if canUpload(churchId);
    }
  }
}
