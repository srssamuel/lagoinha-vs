rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isSameChurch(churchId) {
      return getUserData().churchId == churchId;
    }

    function canUploadAudio(churchId) {
      return isAuthenticated() &&
        isSameChurch(churchId) &&
        getUserData().status == 'active' &&
        getUserData().role in ['admin', 'leader', 'sound_tech'];
    }

    // Isolamento multi-tenant de Stems e Multitracks no Storage
    match /churches/{churchId}/stems/{allPaths=**} {
      // Leitura permitida apenas para membros autenticados da mesma igreja
      allow read: if isAuthenticated() && isSameChurch(churchId);

      // Upload só de áudio (ou .zip de multitrack), por admin, líder ou técnico de som, até 500MB por arquivo
      allow create, update: if canUploadAudio(churchId) &&
        request.resource.size < 500 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') ||
         request.resource.contentType in ['application/zip', 'application/x-zip-compressed']);
      // No delete não há request.resource: a checagem de tamanho bloqueava a exclusão
      allow delete: if canUploadAudio(churchId);
    }

    // Imagens de capa de álbuns ou avatares
    match /churches/{churchId}/covers/{imageFile} {
      allow read: if isAuthenticated() && isSameChurch(churchId);
      allow create, update: if canUploadAudio(churchId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if canUploadAudio(churchId);
    }
  }
}
