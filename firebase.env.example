# Copie para .env.local (fora do git) para rodar o app com o banco online.
# A config do app Web e publica (sai em `npx firebase apps:sdkconfig WEB --project lagoinha-joao-pessoa`),
# mas fica fora do repositorio publico por higiene.
VITE_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=lagoinha-joao-pessoa
VITE_FIREBASE_AUTH_DOMAIN=lagoinha-joao-pessoa.firebaseapp.com
VITE_FIREBASE_APP_ID=1:697356545258:web:647df73ca756a204e37b93
# URL do Worker de stems depois do `wrangler deploy` (workers/stems/README.md)
VITE_STEMS_WORKER_URL=https://lagoinha-vs-stems.lagoinha-vs-stems.workers.dev
